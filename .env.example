# ───────────────────────── API del SIRE · variables de entorno ─────────────────────────
# Copia este archivo a .env (nunca lo subas a git) y completa los valores.

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Postgres. En desarrollo sin Docker: `npm run dev:db` y usa la URL de abajo.
# En producción usa el Postgres administrado (añade ?sslmode=require si lo pide).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# Cifra la Clave SOL y el client_secret de cada empresa. 32 bytes en base64:
#   openssl rand -base64 32
# Si se pierde, las credenciales guardadas no se pueden recuperar (hay que volver a registrarlas).
APP_ENCRYPTION_KEY=

# Texto largo y secreto para derivar el hash del api_secret de cada empresa.
#   openssl rand -base64 48
API_KEY_PEPPER=

# Quien llame a POST /api/v1/registro (crear empresas) debe enviar `Authorization: Bearer <este valor>`.
# OBLIGATORIO en producción. En desarrollo puede quedar vacío.
REGISTRATION_TOKEN=

# ── SUNAT ────────────────────────────────────────────────────────────────────────────
SUNAT_API_BASE=https://api-sire.sunat.gob.pe
SUNAT_AUTH_BASE=https://api-seguridad.sunat.gob.pe

# INTERRUPTOR DE SEGURIDAD. Mientras sea false, NADA sale hacia SUNAT (el SIRE no tiene ambiente de pruebas).
# Se activa a propósito, cuando se decida hacer consultas reales.
SUNAT_LIVE=false

# Segundo interruptor: las operaciones que ESCRIBEN en SUNAT (aceptar, reemplazar, registrar, enviar).
# Hoy la API es de solo lectura: déjalo en false.
SIRE_WRITES_ENABLED=false

SUNAT_TIMEOUT_MS=60000
# Espera mínima entre llamadas de una misma empresa (SUNAT responde 429 si se la abruma).
SUNAT_MIN_INTERVAL_MS=400

# ── Archivos y trabajos en segundo plano ────────────────────────────────────────────
# Dónde se guardan los ZIP/PDF que entrega SUNAT: "postgres" (por defecto; no necesita discos) o "local" (carpeta STORAGE_DIR).
STORAGE_DRIVER=postgres
STORAGE_DIR=./data/archivos
# true = la API corre también el worker (un solo servicio). false = el worker va aparte (`npm run start:worker`).
RUN_WORKER_IN_API=true
# Máximo de conexiones a Postgres (los planes chicos permiten pocas).
DB_POOL_MAX=10
WORKER_INTERVAL_MS=2000
TICKET_MAX_POLLS=40
TICKET_FIRST_POLL_MS=3000
